rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* rooms/{roomId} 한 문서에 가족·매장·출납부·추가 캘린더 방이 모두 있고, 아래 목록으로 접근을 판정합니다.
       allowedUids = 승인된 기기(읽기·쓰기) · adminUids = 관리자 · revokedUids = 내보내기/퇴사 차단 */
    function rp(rid) { return /databases/$(database)/documents/rooms/$(rid); }
    function rex(rid) { return exists(rp(rid)); }
    function rd(rid) { return get(rp(rid)).data; }
    function si() { return request.auth != null; }
    function inList(m, k) { return m.keys().hasAny([k]) && m[k] is list && request.auth.uid in m[k]; }
    function isAllowed(rid) { return si() && rex(rid) && inList(rd(rid), 'allowedUids'); }
    function isAdmin(rid) { return si() && rex(rid) && inList(rd(rid), 'adminUids'); }
    function isRevoked(rid) { return si() && rex(rid) && inList(rd(rid), 'revokedUids'); }
    function canRead(rid) { return isAllowed(rid) && !isRevoked(rid); }
    function proto() { return ['allowedUids', 'adminUids', 'revokedUids', 'revokedDevices']; }
    /* 승인 목록이 아직 없는 방(이전 버전)에 코드를 아는 기기 한 대가 자기만 등록 */
    function firstClaim(rid) {
      return si() && rex(rid) && !rd(rid).keys().hasAny(['allowedUids']) && !isRevoked(rid)
        && request.resource.data.allowedUids is list
        && request.resource.data.allowedUids.size() == 1
        && request.resource.data.allowedUids[0] == request.auth.uid
        && request.resource.data.adminUids is list
        && request.resource.data.adminUids.size() == 1
        && request.resource.data.adminUids[0] == request.auth.uid;
    }

    match /rooms/{roomId} {
      /* 1) 읽기 — 승인된 기기만. 방 목록 조회(list)는 계속 막습니다.
            아직 방이 없을 때(404)는 "새 방 만들기"를 위해 통과시키고, 방이 있으면 승인 목록을 봅니다. */
      allow get: if (si() && !rex(roomId)) || canRead(roomId);

      /* 2) 만들기 — 만든 기기가 곧 관리자. 허용 목록에는 자기 한 명만. */
      allow create: if si()
        && request.resource.data.keys().hasAny(['allowedUids', 'adminUids'])
        && request.resource.data.allowedUids is list
        && request.resource.data.allowedUids.size() == 1
        && request.resource.data.allowedUids[0] == request.auth.uid
        && request.resource.data.adminUids is list
        && request.resource.data.adminUids.size() == 1
        && request.resource.data.adminUids[0] == request.auth.uid;

      /* 3) 관리자 — 구성원·허용/차단 목록·PIN 까지 모두 */
      allow update: if isAdmin(roomId) && !isRevoked(roomId);

      /* 4) 승인된 구성원 — 일정·구성원·급여는 자유롭게, 허용/차단/관리자 목록은 못 건드림 */
      allow update: if canRead(roomId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(proto());

      /* 5) 승인 목록이 없는 방에 처음 온 기기 — 자기 한 명만 등록(방장) */
      allow update: if firstClaim(roomId);

      /* 6) 추가 캘린더(autoJoin) — 코드를 아는 기기가 자기만 추가 */
      allow update: if si() && rex(roomId) && !isRevoked(roomId) && !isAllowed(roomId)
        && rd(roomId).keys().hasAny(['autoJoin']) && rd(roomId).autoJoin == true
        && rd(roomId).allowedUids is list
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['allowedUids'])
        && request.resource.data.allowedUids.hasAll(resource.data.allowedUids)
        && request.resource.data.allowedUids.size() == resource.data.allowedUids.size() + 1
        && request.auth.uid in request.resource.data.allowedUids;

      /* 일정·근무·출납 내역·사진·인수인계 — 방 구성원만 */
      match /events/{eventId} { allow read, write: if canRead(roomId); }

      /* 입장 요청 — 아직 구성원이 아닌 기기는 자기 요청 한 건만, 관리자는 목록·승인 */
      match /joinRequests/{reqId} {
        allow get: if si() && (request.auth.uid == reqId || canRead(roomId));
        allow list: if canRead(roomId);
        allow create: if si() && request.auth.uid == reqId && rex(roomId) && !isRevoked(roomId)
          && request.resource.data.keys().hasOnly(['uid', 'name', 'tel', 'device', 'status', 'requestedAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.status == 'pending'
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 24;
        allow update: if canRead(roomId)
          || (si() && request.auth.uid == reqId
              && request.resource.data.uid == request.auth.uid
              && request.resource.data.status == 'pending'
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['status', 'requestedAt', 'name', 'tel', 'device']));
        allow delete: if canRead(roomId);
      }
    }
  }
}
