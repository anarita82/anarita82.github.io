rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* ───────── 방 문서 판정 도우미 ─────────
       rooms/{roomId} 한 문서에 방 종류(가족·매장·출납부·추가 캘린더)가 모두 모여 있고,
       아래 목록으로만 접근을 판정합니다.
         allowedUids : 이 방을 읽고 쓸 수 있는 계정(uid) 목록 — 승인된 기기
         adminUids   : 관리자 권한 계정 목록 — 구성원·허용/차단 목록·PIN을 바꿀 수 있음
         revokedUids : 내보내기·퇴사로 차단된 계정 — allowedUids 에 남아 있어도 막힘 */
    function roomPath(rid) {
      return /databases/$(database)/documents/rooms/$(rid);
    }
    function roomExists(rid) {
      return exists(roomPath(rid));
    }
    function roomData(rid) {
      return get(roomPath(rid)).data;
    }
    function signedIn() {
      return request.auth != null;
    }
    function inList(map, key) {
      return map.keys().hasAny([key]) && map[key] is list && request.auth.uid in map[key];
    }
    function isAllowed(rid) {
      return signedIn() && roomExists(rid) && inList(roomData(rid), 'allowedUids');
    }
    function isAdmin(rid) {
      return signedIn() && roomExists(rid) && inList(roomData(rid), 'adminUids');
    }
    function isRevoked(rid) {
      return signedIn() && roomExists(rid) && inList(roomData(rid), 'revokedUids');
    }
    function canRead(rid) {
      return isAllowed(rid) && !isRevoked(rid);
    }
    /* 관리자·구성원이 일반 저장으로는 건드릴 수 없는 필드 — 허용/차단·관리자 목록 */
    function protectedFields() {
      return ['allowedUids', 'adminUids', 'revokedUids', 'revokedDevices'];
    }
    /* 승인 목록이 아직 없는 방(이전 버전에서 만든 방)에 코드를 아는 기기 한 대가 자기만 등록 */
    function firstClaim(rid) {
      return signedIn() && roomExists(rid) && !roomData(rid).keys().hasAny(['allowedUids'])
        && !isRevoked(rid)
        && request.resource.data.allowedUids is list
        && request.resource.data.allowedUids.size() == 1
        && request.resource.data.allowedUids[0] == request.auth.uid
        && request.resource.data.adminUids is list
        && request.resource.data.adminUids.size() == 1
        && request.resource.data.adminUids[0] == request.auth.uid;
    }

    match /rooms/{roomId} {

      /* 1) 읽기 — 승인된 기기만. 방 목록 조회(list)는 계속 막습니다. */
      allow get: if canRead(roomId);

      /* 2) 방 만들기 — 만든 기기가 곧 관리자. 허용 목록에는 자기 한 명만. */
      allow create: if signedIn()
        && request.resource.data.keys().hasAny(['allowedUids', 'adminUids'])
        && request.resource.data.allowedUids is list
        && request.resource.data.allowedUids.size() == 1
        && request.resource.data.allowedUids[0] == request.auth.uid
        && request.resource.data.adminUids is list
        && request.resource.data.adminUids.size() == 1
        && request.resource.data.adminUids[0] == request.auth.uid;

      /* 3) 관리자 — 구성원·허용/차단 목록·PIN 까지 모두 바꿀 수 있음 */
      allow update: if isAdmin(roomId) && !isRevoked(roomId);

      /* 4) 승인된 구성원 — 일정·구성원·급여·메모 등은 자유롭게,
            허용/차단/관리자 목록과 PIN 은 못 건드림 */
      allow update: if canRead(roomId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedFields());

      /* 5) 아직 승인 목록이 없는 방에 처음 들어온 기기 — 자기 한 명만 등록(방장) */
      allow update: if firstClaim(roomId);

      /* 6) 초대 코드로 바로 참여하는 추가 캘린더(autoJoin) — 코드를 아는 기기가 자기만 추가 */
      allow update: if signedIn()
        && roomExists(roomId)
        && !isRevoked(roomId)
        && !isAllowed(roomId)
        && roomData(roomId).keys().hasAny(['autoJoin'])
        && roomData(roomId).autoJoin == true
        && roomData(roomId).allowedUids is list
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['allowedUids'])
        && request.resource.data.allowedUids.hasAll(resource.data.allowedUids)
        && request.resource.data.allowedUids.size() == resource.data.allowedUids.size() + 1
        && request.auth.uid in request.resource.data.allowedUids;

      /* 7) 방 지우기는 막습니다(관리자도 실수 방지). */

      /* 일정·근무·출납 내역·사진·인수인계 — 방 구성원만 읽고 씁니다 */
      match /events/{eventId} {
        allow read, write: if canRead(roomId);
      }

      /* 입장 요청 — 아직 구성원이 아닌 기기는 자기 요청 한 건만 만들고 자기 것만 볼 수 있고,
         관리자·구성원은 목록을 보고 승인/거절(상태 변경)할 수 있습니다. */
      match /joinRequests/{reqId} {
        allow get: if signedIn() && (request.auth.uid == reqId || canRead(roomId));
        allow list: if canRead(roomId);
        allow create: if signedIn()
          && request.auth.uid == reqId
          && roomExists(roomId)
          && !isRevoked(roomId)
          && request.resource.data.keys().hasOnly(['uid', 'name', 'tel', 'device', 'status', 'requestedAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.status == 'pending'
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 24;
        /* 자기 요청은 거절된 뒤 다시 보내거나, 대기 중에 이름·번호를 고칠 수 있음 */
        allow update: if canRead(roomId)
          || (signedIn() && request.auth.uid == reqId
              && request.resource.data.uid == request.auth.uid
              && request.resource.data.status == 'pending'
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['status', 'requestedAt', 'name', 'tel', 'device']));
        allow delete: if canRead(roomId);}
      }
    }
  }
}
